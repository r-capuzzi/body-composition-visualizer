# Set these in your deployment platform's environment settings (this file
# isn't auto-loaded - main.py reads os.environ directly, no dotenv).

# Comma-separated. Left unset, the API only allows the Vite dev server's origin.
ALLOWED_ORIGINS=https://your-frontend-host.example.com

# Optional regex for origins that can't be listed ahead of time - e.g. Vercel's
# preview deployments, which get a new URL per deployment and per branch:
#   <project>-<hash>-<scope>.vercel.app  and  <project>-git-<branch>-<scope>.vercel.app
# Left unset, previews can't reach the API.
ALLOWED_ORIGIN_REGEX=https://your-project-(git-[a-z0-9-]+|[a-z0-9]+)-your-scope\.vercel\.app
